# Proofloop Environment Configuration Template

# Database - Neon PostgreSQL
# DATABASE_URL: Pooled connection string for application runtime (e.g., ep-...-pooler.us-east-2.aws.neon.tech)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# MIGRATION_DATABASE_URL: Direct unpooled connection string for migrations and DDL
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# TEST_DATABASE_URL: Connection string for RLS integration test suite
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication - Better Auth
# BETTER_AUTH_SECRET: Cryptographically random string (at least 32 characters)
BETTER_AUTH_SECRET=generate_a_random_32_plus_char_secret_here_12345
BETTER_AUTH_URL=http://localhost:3000

# Demo Mode Toggle
# Set to "true" ONLY for offline local evaluation without PostgreSQL
PROOFLOOP_DEMO_MODE=false

# AI Provider - Meta Muse Spark (Optional / Staging)
# MODEL_API_KEY=your_meta_model_api_key_here
# META_MODEL_API_ENDPOINT=https://api.meta.ai/v1/chat/completions
# META_MODEL_ID=muse-spark-1.3

# Email Delivery - Gmail SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
